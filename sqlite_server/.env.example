# SQLite dataset service environment variables
# Copy to `.env` and adjust.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Shared secret required on every data endpoint. This service holds user data
# and must not be reachable directly from a browser: the Flask API authenticates
# the user and checks dataset ownership before proxying here.
# Must match SERVICE_TOKEN in server/.env and langgraph_agent/.env.
# Required in production; when unset locally the check is skipped and a warning
# is logged on every request.
SERVICE_TOKEN=change-me-shared-between-services

# ---------------------------------------------------------------------------
# CORS  (comma-separated; required in production and may not be "*")
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Where uploaded databases are written. Defaults to ./uploads
# UPLOAD_DIR=./uploads

# 100MB
MAX_FILE_SIZE=104857600
# How often the expiry sweep runs (1 hour)
DB_CLEANUP_INTERVAL=3600000
# How long an uploaded database is kept (4 hours)
DB_FILE_RETENTION=14400000

# ---------------------------------------------------------------------------
# Query limits
# ---------------------------------------------------------------------------
MAX_QUERY_ROWS=5000
PREVIEW_ROW_LIMIT=50
QUERY_TIMEOUT_MS=15000
