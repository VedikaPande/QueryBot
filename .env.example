# QueryBot — Docker Compose configuration
#
#   cp .env.example .env
#   Fill in GROQ_API_KEY and the three secrets below, then:
#   docker compose up --build
#
# Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   # or: openssl rand -base64 32

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# One model provider's API key. Groq is the default because it is the cheapest
# and fastest for this workload; to use another, set LLM_PROVIDER below and fill
# in its key instead. The agent refuses to start without the key for whichever
# provider is selected.
# From https://console.groq.com
GROQ_API_KEY=

# Flask session signing. Must differ from JWT_SECRET_KEY.
SECRET_KEY=

# JWT signing.
JWT_SECRET_KEY=

# Shared secret authenticating the internal services to each other. Compose
# injects the same value everywhere, so it only needs setting once here.
SERVICE_TOKEN=

# PostgreSQL password.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

CLIENT_PORT=8080
POSTGRES_USER=querybot
POSTGRES_DB=querybot

# Model provider: groq | openai | anthropic | google. Set the matching key.
LLM_PROVIDER=groq
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Overrides the provider's default model (groq openai/gpt-oss-120b, openai gpt-5,
# anthropic claude-opus-5, google gemini-2.5-pro). Set this when a provider
# retires or renames one — Groq does so periodically, and a stale name fails the
# run with `model_not_found`. Current Groq models: console.groq.com/docs/models
LLM_MODEL=

LOG_LEVEL=INFO

# Chart rendering runs generated Python in a sibling container, which requires
# mounting the host Docker socket into the agent. That is equivalent to giving
# the agent root on the host, so it is disabled by default.
#
# To enable it, set both of these:
#   CHART_DOCKER_ENABLED=true
#   DOCKER_SOCKET=/var/run/docker.sock
#
# Everything except chart images works with it off.
CHART_DOCKER_ENABLED=false
DOCKER_SOCKET=/dev/null

# Set to true when serving over HTTPS so cookies carry the Secure flag.
JWT_COOKIE_SECURE=false

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Upload limits (bytes / milliseconds).
MAX_FILE_SIZE=104857600
DB_FILE_RETENTION=14400000
