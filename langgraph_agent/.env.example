# LangGraph agent environment variables
# Copy to `.env` and fill in real values.

# ---------------------------------------------------------------------------
# Model  (required)
# ---------------------------------------------------------------------------
# Which provider serves every model call: groq | openai | anthropic | google.
# Only the selected provider's API key is needed.
LLM_PROVIDER=groq

# From https://console.groq.com
GROQ_API_KEY=your-groq-api-key
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Overrides the provider's default model. Leave unset to take the default:
#   groq       openai/gpt-oss-120b
#   openai     gpt-5
#   anthropic  claude-opus-5
#   google     gemini-2.5-pro
# Set this when a provider retires or renames a model - Groq in particular does
# so periodically, and a stale name fails the run with `model_not_found`.
LLM_MODEL=

# Still honoured when LLM_PROVIDER=groq, for deployments that already set it.
GROQ_MODEL=

TEMPERATURE=0
LLM_MAX_RETRIES=2
# Output cap per call. Every provider except Groq needs one, and their own
# defaults are too low: langchain-anthropic caps at 1024, which truncates the
# insight analysis mid-sentence.
LLM_MAX_OUTPUT_TOKENS=4096

# ---------------------------------------------------------------------------
# Dataset service
# ---------------------------------------------------------------------------
SQLITE_SERVICE_URL=http://localhost:3001
# Must match SERVICE_TOKEN in sqlite_server/.env and server/.env.
SERVICE_TOKEN=change-me-shared-between-services
SQLITE_REQUEST_TIMEOUT=60

# ---------------------------------------------------------------------------
# Chart generation
# ---------------------------------------------------------------------------
# Charts render inside a Docker container with no network access. Set to false
# on hosts without a Docker daemon: answers, tables and insights still work and
# chart requests report that charts are unavailable.
CHART_DOCKER_ENABLED=true
CHART_EXECUTOR_IMAGE=querybot-chart-executor
CHART_OUTPUT_DIR=./generated_charts
CHART_TIMEOUT=120

# ---------------------------------------------------------------------------
# Query limits
# ---------------------------------------------------------------------------
MAX_RESULT_ROWS=5000
# Rows sent to the model for analysis; the full result still reaches the client.
LLM_SAMPLE_ROWS=30

# ---------------------------------------------------------------------------
# Conversation
# ---------------------------------------------------------------------------
# Recognise a follow-up that only changes presentation ("make it a pie chart",
# "use warmer colours", "top 5 only") and re-run the previous query rather than
# writing a new one. Set to false to answer every turn from scratch.
REFINE_FOLLOWUPS=true
# Follow-up question suggestions offered after each answer.
SUGGEST_FOLLOWUPS=true

# ---------------------------------------------------------------------------
# Tracing  (optional)
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=querybot-agent
