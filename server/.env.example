# Flask API environment variables
# Copy to `.env` and fill in real values.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# development | production | testing
FLASK_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Security  (production refuses to start unless these are set)
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-value
JWT_SECRET_KEY=change-me-generate-a-different-long-random-value

JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite is fine for local development:
DATABASE_URL=sqlite:///querybot.db
# PostgreSQL is required in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/querybot

# ---------------------------------------------------------------------------
# CORS  (comma-separated; must not be "*" because auth uses cookies)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# SQLite dataset service
# ---------------------------------------------------------------------------
SQLITE_SERVICE_URL=http://localhost:3001
# Shared secret authenticating this server to the dataset service. Must match
# SERVICE_TOKEN in sqlite_server/.env and langgraph_agent/.env.
SERVICE_TOKEN=change-me-shared-between-services
SQLITE_SERVICE_TIMEOUT=120

# ---------------------------------------------------------------------------
# LangGraph agent
# ---------------------------------------------------------------------------
LANGGRAPH_API_URL=http://localhost:8000
LANGGRAPH_ASSISTANT_ID=agent
# Only needed when connecting to LangGraph Platform rather than a local server.
LANGSMITH_API_KEY=

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=104857600
